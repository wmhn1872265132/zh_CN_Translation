      <segment state="final">
        <source>- NVDA + alt + 7: Announces the power consumption.</source>
        <target>- NVDA + alt + 7：播报功耗。</target>
      </segment>
    </unit>
    <unit id="510794c9-5d79-4769-867f-62ccfce78028">
      <notes>
        <note appliesTo="source">line: 22</note>
