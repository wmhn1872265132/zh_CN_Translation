      <segment state="final">
        <source>- NVDA + alt + 8: Announces the power limit.</source>
        <target>- NVDA + alt + 8：播报功耗限制。</target>
      </segment>
    </unit>
    <unit id="bb1d8792-2f1f-4323-bb04-64609e909cde">
      <notes>
