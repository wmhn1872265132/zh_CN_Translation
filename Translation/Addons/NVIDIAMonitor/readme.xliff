      <notes>
        <note appliesTo="source">line: 17</note>
      </notes>
      <segment state="final">
        <source>- NVDA + alt + 3: Announces the free memory.</source>
        <target>- NVDA + alt + 3：播报可用显存。</target>
      </segment>
